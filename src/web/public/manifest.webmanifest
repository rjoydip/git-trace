{
  "name": "GitTrace — Repository Context Control Room",
  "short_name": "GitTrace",
  "description": "Trace a repository's history, contributors, hot files and pull requests from one control room.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
