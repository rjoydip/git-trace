{
  "name": "git-trace",
  "version": "0.1.0",
  "private": true,
  "description": "Trace a Git repository's history — commits, contributors, activity, and hot files.",
  "bin": {
    "git-trace": "./dist/cli/index.js"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "cli": "bun run src/cli/index.ts",
    "docs:cli": "bun run scripts/cli-docs.ts",
    "emulate": "bun run scripts/emulate.ts",
    "build": "bun run build:web && bun run build:worker && bun run build:cli",
    "build:cli": "bun build src/cli/index.ts --target=node --outfile=dist/cli/index.js",
    "build:web": "vite build",
    "build:worker": "vite build --config config/vite.worker.ts",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint . --deny-warnings",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "bun test",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@pierre/trees": "1.0.0-beta.6",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "hono": "^4.13.16",
    "motion": "^14.9.1",
    "notch-toast": "^0.2.0",
    "react-syntax-highlighter": "^16.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/bun": "^1.4.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "emulate": "^0.13.0",
    "lucide-react": "^1.69.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.91.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "wrangler": "^4.158.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.4.2"
}
